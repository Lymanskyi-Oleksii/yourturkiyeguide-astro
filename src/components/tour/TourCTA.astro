---
interface Props {
    title?: string;
    subtitle?: string;
}

const {
    title = "Остались вопросы?",
    subtitle = "Можно задать все вопросы организатору до оплаты!",
} = Astro.props;
---
<div class="cta">
    <h2>{title}</h2>
    <p>{subtitle}</p>
    <a href="https://t.me/+905443266871" target="_blank" class="cta-btn">Связаться в Telegram</a>
    <a href="https://wa.me/+905443266871" target="_blank" class="cta-btn1">Связаться в WhatsApp</a>
</div>
<style>
    .cta {
        text-align: center;
        padding: 40px 20px;
        margin-top: 40px;
    }

    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .cta h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 16px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.3;
        animation: slideUp 0.6s ease-out;
    }

    .cta p {
        font-size: 1.1rem;
        color: #5a6c7d;
        margin-bottom: 30px;
        line-height: 1.6;
        font-weight: 400;
        animation: slideUp 0.6s ease-out 0.2s both;
    }

    .cta a {
        margin: 0 8px 10px;
    }

    .cta-btn {
        display: inline-block;
        padding: 14px 28px;
        background: linear-gradient(135deg, #3498db, #2980b9);
        color: #fff;
        text-decoration: none;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
        animation: slideUp 0.6s ease-out 0.4s both;
        position: relative;
        overflow: hidden;
    }

    .cta-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(52, 152, 219, 0.4);
        background: linear-gradient(135deg, #2980b9, #1abc9c);
    }

    .cta-btn1 {
        display: inline-block;
        padding: 14px 28px;
        background: linear-gradient(135deg, #25D366, #128C7E);
        color: #fff;
        text-decoration: none;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
        animation: slideUp 0.6s ease-out 0.6s both;
        position: relative;
        overflow: hidden;
    }

    .cta-btn1:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(37, 211, 102, 0.4);
        background: linear-gradient(135deg, #128C7E, #075E54);
    }

    .cta-btn::before, .cta-btn1::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.5s;
    }

    .cta-btn:hover::before, .cta-btn1:hover::before {
        left: 100%;
    }

    @media (max-width: 768px) {
        .cta {
            padding: 40px 30px;
            margin: 20px;
        }

        .cta h2 {
            font-size: 1.8rem;
        }

        .cta p {
            font-size: 1.1rem;
        }

        .cta-btn, .cta-btn1 {
            width: 100%;
            max-width: 280px;
        }
    }

    @media (max-width: 320px) {
        .cta {
            padding: 25px 15px;
            margin-top: 25px;
        }

        .cta h2 {
            font-size: 1.4rem;
            margin-bottom: 12px;
        }

        .cta p {
            font-size: 0.9rem;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .cta-btn,
        .cta-btn1 {
            padding: 12px 20px;
            font-size: 0.85rem;
            border-radius: 10px;
        }
    }
</style>