---
import { imageVariant } from '../../lib/images';

interface Photo { image: string; title: string; video?: string; thumb?: string; }
interface Props { photos: Photo[]; }

// Мініатюри беремо зі зменшених копій (thumbs/), щоб не вантажити оригінали
const photos = Astro.props.photos.map((photo) => ({
    ...photo,
    thumb: photo.thumb ?? imageVariant(photo.image, 'thumbs'),
}));
---
<div class="vertical-display" tabindex="0" role="region" aria-label="Фотогалерея">
    <div class="main-photo-display" id="mainPhotoDisplay">
        <div class="photo-placeholder" id="mainPhotoContainer">
            <span>📷</span>
            <span>Загрузка изображения...</span>
        </div>
        <div class="photo-counter">
            <span id="currentPhoto">1</span> / <span id="totalPhotos">{photos.length}</span>
        </div>
        <div class="photo-progress" id="photoProgress" style={`width: ${100 / photos.length}%;`}></div>
    </div>
    <div class="photo-thumbnails" id="photoThumbnails"></div>
</div>

<div class="second-gallery-info">
    <p>Нажмите на галерею, затем используйте клавиши ↑/↓ для навигации</p>
    <p>Enter - полноэкранный режим</p>
    <div class="photo-error" id="photoError" style="display: none;"></div>
</div>

<script is:inline define:vars={{ photos }}>
    window.gallerySlides = photos;
</script>

<script>
    // Галерея фото і повноекранний перегляд (кнопки оверлея обробляються в цьому скрипті)
    import '../../scripts/pages/galleria.js';
</script>
