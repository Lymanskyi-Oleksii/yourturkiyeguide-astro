---
interface Props {
    image: string;
    title: string;
    subtitle: string;
}
const { image, title, subtitle } = Astro.props;
---
<div class="photo-container" style={`background-image: url('${image}');`}>
    <div class="text-content">
        <h1>{title}</h1>
        <p>{subtitle}</p>
    </div>
</div>