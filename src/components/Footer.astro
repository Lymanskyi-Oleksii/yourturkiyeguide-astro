---
import { SITE } from '../data/site';
---
<footer>
    <div class="footer-contact">
        <p>📞 Телефон:<a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></p>
        <p>📧 Email: <a href={`mailto:${SITE.email}`}> {SITE.email}</a></p>
    </div>
    <div class="footer-social">
        <a href={SITE.facebook} target="_blank"><img src="/assets/img/icon/facebook-icon.webp" alt="Facebook" width="24" height="24" loading="lazy" decoding="async"></a>
        <a href={SITE.instagram} target="_blank"><img src="/assets/img/icon/instagram-icon.webp" alt="Instagram" width="24" height="24" loading="lazy" decoding="async"></a>
        <a href={SITE.telegram} target="_blank"><img src="/assets/img/icon/telegram-icon.webp" alt="Telegram" width="24" height="24" loading="lazy" decoding="async"></a>
        <a href={SITE.whatsapp} target="_blank"><img src="/assets/img/icon/free-icon-whatsapp-4494494.webp" alt="WhatsApp" width="24" height="24" loading="lazy" decoding="async"></a>
        <a href={SITE.viber} target="_blank"><img src="/assets/img/icon/free-icon-viber-3670059.webp" alt="Viber" width="24" height="24" loading="lazy" decoding="async"></a>
    </div>
    <div class="footer-copy">
        <p>&copy; 2026 {SITE.name}. Все права защищены.</p>
    </div>
</footer>

<nav class="mobile-menu">
    <a href="/">
        <img src="/assets/img/icon/home.webp" alt="Главная" width="24" height="24">
    </a>
    <a href="/about">
        <img src="/assets/img/icon/man.webp" alt="Обо мне" width="24" height="24">
    </a>
    <a href="/excursions">
        <img src="/assets/img/icon/destination.webp" alt="Экскурсии" width="24" height="24">
    </a>
    <a href="/services">
        <img src="/assets/img/icon/yatch.webp" alt="Яхты" width="24" height="24">
    </a>
    <a href="/reviews">
        <img src="/assets/img/icon/customer-feedback.webp" alt="Отзывы" width="24" height="24">
    </a>
</nav>