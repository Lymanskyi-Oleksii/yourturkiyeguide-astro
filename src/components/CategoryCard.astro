---
import { imageVariant } from '../lib/images';

interface Props {
    href: string;
    image: string;
    title: string;
    description?: string;
}

const { href, image, title, description } = Astro.props;
---
<div class="category-item">
    <a href={href} class="clickable-link">
        <div class="card">
            <!-- Звичайний img замість background-image, щоб фото вантажилось ліниво -->
            <img class="card-image" src={imageVariant(image, 'medium')} alt="" width="320" height="420" loading="lazy" decoding="async">
            <div class="card-content">
                <h1>{title}</h1>
                <button class="arrow-button"><span class="arrow">→</span></button>
            </div>
        </div>
    </a>
    {description && <p class="card-caption">{description}</p>}
</div>

<style>
    /* Фото картки на весь фон, під затемненням (::before) і текстом */
    .card-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
    }
</style>
