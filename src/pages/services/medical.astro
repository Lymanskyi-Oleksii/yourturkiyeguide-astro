---
import BaseLayout from '../../layouts/BaseLayout.astro';
// Стилі підключаються імпортом: Astro їх мініфікує й дає назви з хешем (пункт 6.4)
import '../../styles/pages/excursions.css';
import TourCTA from '../../components/tour/TourCTA.astro';
---
<BaseLayout title="Медицинский туризм" description="Медицинский туризм в Турции: подбор клиники под вашу задачу, перевод и сопровождение на всех этапах лечения.">
    <section>
        <div class="container">
            <article class="container-article">
                <h1 class="page-title">Медицинский туризм</h1>

                <div class="service-text">
                    <p>Турция — одно из популярных направлений для лечения за рубежом. Помогу разобраться в выборе и пройти весь путь спокойно: подберу клинику под вашу конкретную задачу — с учётом профиля лечения, стоимости и отзывов.</p>
                    <p>Сопровождаю на всех этапах: помогаю с переводом, хожу с вами на приём к врачу, организую <a href="/services/transfer">трансфер</a> из аэропорта и между клиникой и отелем. Если останется время, медицинскую консультацию можно совместить с экскурсией или <a href="/services/shopping">шопингом</a>.</p>
                </div>

                <TourCTA
                        title="Нужна помощь с лечением в Турции?"
                        subtitle="Опишите вашу задачу — подскажу, с чего начать, и подберу клинику."
                />
            </article>
        </div>
    </section>
</BaseLayout>

<style>
    .page-title {
        font-size: clamp(1.8rem, 6vw, 2.5rem);
        font-weight: 700;
        text-align: center;
        margin-bottom: 24px;
        background: linear-gradient(135deg, var(--primary), var(--secondary), var(--accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.3;
    }

    .service-text {
        max-width: 760px;
        margin: 0 auto;
        font-size: 1.05rem;
        line-height: 1.7;
        color: #2c3e50;
    }

    .service-text p {
        margin-bottom: 16px;
    }

    .service-text a {
        color: #2980b9;
        text-decoration: underline;
    }
</style>
