---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoSplide from '../../components/tour/PhotoSplide.astro';
import ServicesFAQ from '../../components/tour/ServicesFAQ.astro';
import TourCTA from '../../components/tour/TourCTA.astro';

const benefits = [
    {
        title: 'Яхты премиум-класса',
        text: 'Современные судна разной вместимости в безупречном техническом состоянии с профессиональным экипажем.',
    },
    {
        title: 'Любой формат под ключ',
        text: 'От экскурсии до романтического свидания на закате, семейного завтрака или масштабного празднования дня рождения и других важных дат.',
    },
    {
        title: 'Эксклюзивный маршрут',
        text: 'Адаптируем прогулку под ваши пожелания — с заходом в тихие бухты, выходом в Мраморное море или к Принцевым островам.',
    },
    {
        title: 'Другие услуги на борту',
        text: 'Изысканный кейтеринг, живая музыка и услуги профессионального фотографа.',
    },
];

const galleryItems = [
    { image: '/assets/img/yachts/1.webp', alt: 'Яхта у берегов Стамбула' },
    { image: '/assets/img/yachts/2.webp', alt: 'Палуба яхты' },
    { image: '/assets/img/yachts/3.webp', alt: 'Закат на яхте' },
    { image: '/assets/img/yachts/4.webp', alt: 'Каюта яхты' },
    { image: '/assets/img/yachts/5.webp', alt: 'Праздник на яхте' },
    { image: '/assets/img/yachts/6.webp', alt: 'Вид на Стамбул с яхты' },
];
---
<BaseLayout title="Яхты" description="Аренда частных яхт в Стамбуле — прогулки по Босфору, романтические ужины и праздники на воде.">
    <Fragment slot="head">
        <link rel="stylesheet" href="/assets/css/layout/accordion.css">
    </Fragment>

    <section>
        <div class="container">
            <article>
                <div class="tours-section yachts-intro">
                    <h1>Аренда яхт в Стамбуле</h1>
                    <p class="lead">Покорите Босфор на роскошной частной яхте и взгляните на Стамбул с самого лучшего ракурса!</p>
                    <p>Морская прогулка по Босфору — это незабываемый опыт, который останется с вами навсегда. Проплывая мимо величественных османских дворцов, старинных крепостей и ультрасовременных вилл, вы прочувствуете истинную магию Стамбула и масштаб этого города без спешки и посторонних глаз.</p>
                </div>

                <PhotoSplide items={galleryItems} id="yachts-gallery" autoplay={true} />

                <div class="benefits-block">
                    <h2>Ваш идеальный день на воде</h2>
                    <div class="benefits-grid">
                        {benefits.map((b) => (
                                <div class="benefit-card">
                                    <h3>{b.title}</h3>
                                    <p>{b.text}</p>
                                </div>
                        ))}
                    </div>
                </div>

                <div class="tours-section closing-block">
                    <p>Оставьте суету мегаполиса на берегу и подарите себе роскошь морского путешествия по сердцу Стамбула!</p>
                </div>

                <ServicesFAQ />
                <TourCTA
                        title="Хотите свою прогулку на яхте?"
                        subtitle="Напишите мне дату и повод — подберу яхту и маршрут под ваши пожелания."
                />
            </article>
        </div>
    </section>

    <script is:inline src="/assets/js/pages/accordion.js"></script>

    <style>
        .yachts-intro h1 {
            font-size: clamp(1.8rem, 6vw, 2.5rem);
            font-weight: 700;
            margin-bottom: 16px;
            background: linear-gradient(135deg, var(--primary), var(--secondary), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1.3;
        }

        .yachts-intro .lead {
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--primary);
            margin-bottom: 16px;
        }

        .yachts-intro p,
        .closing-block p {
            color: var(--text-light);
            line-height: 1.7;
            margin-bottom: 12px;
        }

        .closing-block {
            margin-top: 32px;
            text-align: center;
            font-weight: 600;
            color: var(--primary);
        }

        .benefits-block {
            margin-top: 40px;
        }

        .benefits-block h2 {
            font-size: clamp(1.4rem, 4vw, 1.8rem);
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 20px;
        }

        .benefits-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
        }

        .benefit-card {
            background: var(--card-bg);
            border-radius: var(--border-radius-md);
            padding: 24px;
            box-shadow: 0 4px 15px var(--shadow-light);
            transition: var(--transition-default);
        }

        .benefit-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 25px var(--shadow-medium);
        }

        .benefit-card h3 {
            color: var(--primary);
            font-size: 1.1rem;
            margin-bottom: 8px;
        }

        .benefit-card p {
            color: var(--text-light);
            line-height: 1.5;
            font-size: 0.95rem;
        }
    </style>
</BaseLayout>