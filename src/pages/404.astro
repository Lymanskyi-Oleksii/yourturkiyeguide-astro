---
import BaseLayout from '../layouts/BaseLayout.astro';
import TourCTA from '../components/tour/TourCTA.astro';
---
<BaseLayout title="Страница не найдена" description="Такой страницы нет." noindex>
    <section>
        <div class="container">
            <article>
                <h1>Страница не найдена</h1>
                <p>Возможно, ссылка устарела. Посмотрите <a href="/excursions">все экскурсии</a> или вернитесь <a href="/">на главную</a>.</p>
                <TourCTA title="Не нашли нужное?" subtitle="Напишите мне — помогу подобрать экскурсию." />
            </article>
        </div>
    </section>
</BaseLayout>
