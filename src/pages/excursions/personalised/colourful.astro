---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TourHero from '../../../components/tour/TourHero.astro';
import BookingWidget from '../../../components/tour/BookingWidget.astro';
import PhotoGallerySecondary from '../../../components/tour/PhotoGallerySecondary.astro';
import TourAccordion from '../../../components/tour/TourAccordion.astro';
import TourCTA from '../../../components/tour/TourCTA.astro';
import TourReviews from '../../../components/tour/TourReviews.astro';
import FloatingBookingBtn from '../../../components/tour/FloatingBookingBtn.astro';
import PhotoFullscreenOverlay from '../../../components/tour/PhotoFullscreenOverlay.astro';

const secondGalleryPhotos = Array.from({ length: 9 }, (_, i) => ({
    image: `/assets/img/colorful/${i + 1}.webp`,
    title: `Фото ${i + 1}`,
}));

const whatsappMessage = 'Здравствуйте!%20Хочу%20забронировать%20экскурсию%20%22Колоритный%20Стамбул%22.%0A%0A📅%20Дата:%20[введите%20дату]%0A👥%20Количество%20человек:%20[1–6]%0A👶%20Будут%20ли%20дети:%20[да/нет]%0A💬%20Комментарий:%20[ваш%20вопрос]%0A%0AСпасибо!';
---
<BaseLayout title="Колоритный Стамбул" description="Увидеть разные грани прекрасного города: мечеть Сулеймание, район Балат, Собор Святого Георгия.">
    <Fragment slot="head">
        <link rel="stylesheet" href="/assets/css/pages/booking.css">
        <link rel="stylesheet" href="/assets/css/layout/tourMapSelected.css">
        <link rel="stylesheet" href="/assets/css/layout/route.css">
        <link rel="stylesheet" href="/assets/css/layout/galleria.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
        <link rel="stylesheet" href="/assets/css/layout/accordion.css">
        <link rel="stylesheet" href="/assets/css/pages/reviews.css">
        <link rel="stylesheet" href="/assets/css/layout/fix.css">
        <link rel="stylesheet" href="/assets/css/layout/reservation.css">
    </Fragment>

    <section>
        <div class="container">
            <article>

                <TourHero
                        image="/assets/img/colorful/1.webp"
                        title="Колоритный Стамбул"
                        subtitle="Увидеть разные грани прекрасного города"
                />

                <div class="excursion-text">
                    <p>Каждый уголок Стамбула наполнен историей и особой атмосферой. На этой прогулке вы увидите разный город — но всегда красочный и интересный. Заглянете в мечеть Сулеймание, посетите древний храм и церковь из чугуна. Погуляете по разноцветному Балату. Полюбуетесь панорамами с нескольких смотровых площадок. А я расскажу вам всё самое интересное о Стамбуле!</p>

                    <h2 class="section-title">Что вас ожидает</h2>

                    <div class="subsection-title">Мечеть Сулеймание</div>
                    <p class="subsection-text">«Эта мечеть будет стоять вечно!» — заявил архитектор Синан. И угадал. Я познакомлю вас с историей одного из самых известных символов Османской империи. Вы увидите тюрбе (усыпальницу) султана Сулеймана и Роксоланы. И побываете на смотровой площадке с прекрасным видом на Босфор.</p>

                    <div class="subsection-title">Район Балат</div>
                    <p class="subsection-text">Атмосферный контрастный Балат — один из старейших районов города. Когда-то здесь соседствовали разные народы и целых три религии. Сегодня же это один из самых богемных районов Стамбула, где проходят съёмки турецких сериалов. Мы неспешно погуляем по улочкам с разноцветными домиками и понаблюдаем за окружающей жизнью.</p>

                    <div class="subsection-title">Собор Святого Георгия</div>
                    <p class="subsection-text">Главный храм Константинополя со множеством христианских святынь, среди которых столб бичевания Христа, исторические иконы, трон Иоана Златоуста, мощи трёх святителей и трёх святых жён.</p>

                    <div class="subsection-title">Холм Пьер Лоти</div>
                    <p class="subsection-text">Одна из самых известных смотровых площадок Стамбула. Отсюда открывается прекрасный вид на бухту Золотой Рог и почти весь исторический центр города. А ещё здесь есть небольшое кафе, где можно выпить чашечку турецкого чая или кофе и насладиться панорамами.</p>

                    <div class="info-sections">
                        <div class="info-block">
                            <h3 class="info-title">Организационные детали</h3>
                            <ul>
                                <li>Экскурсия пешая, но между некоторыми локациями мы будем перемещаться на общественном транспорте — трамвае или метро. Будет около 8 поездок, стоимость каждой — 27 лир за человека</li>
                                <li>Также дополнительно оплачивается подъём на холм Пьер Лоти на фуникулере — 27 лир за человека (по желанию)</li>
                                <li>По понедельникам вход в усыпальницу закрыт</li>
                                <li>Мы будем посещать храмы и мечети, поэтому, пожалуйста, позаботьтесь о соответствующей одежде (как женщины, так и мужчины)</li>
                            </ul>
                        </div>
                    </div>

                    <div class="meeting-point">
                        <h3 class="info-title">Место встречи</h3>
                        <p>По договорённости с организатором. Вы можете обсудить его в заказе до предоплаты.</p>
                    </div>
                </div>

                <div class="booking-conditions">
                    <h1 class="title">Условия бронирования</h1>
                    <div class="conditions-grid">
                        <div class="condition-card">
                            <span class="condition-icon">👥</span>
                            <h3 class="condition-title">Индивидуальный формат</h3>
                            <p class="condition-description">Только для вас и вашей компании, <span class="highlight">1-6 человек</span></p>
                        </div>
                        <div class="condition-card">
                            <span class="condition-icon">💰</span>
                            <h3 class="condition-title">Предоплата 20%</h3>
                            <p class="condition-description"><span class="highlight">остальное —</span><br>организатору напрямую</p>
                        </div>
                        <div class="condition-card">
                            <span class="condition-icon">🗣️</span>
                            <h3 class="condition-title">Проходит на русском языке</h3>
                            <p class="condition-description">Экскурсия проводится на русском языке для лучшего понимания</p>
                        </div>
                        <div class="condition-card">
                            <span class="condition-icon">❓</span>
                            <h3 class="condition-title">Задать вопросы организатору</h3>
                            <p class="condition-description">можно <span class="highlight">в заказе до предоплаты</span></p>
                        </div>
                    </div>
                </div>

                <BookingWidget
                        duration="3,5 часа наслаждения"
                        format="1-6 человек - Семейный"
                        method="Пешком с интересными остановками"
                        price="€155"
                        priceNote="за 1–6 человек, независимо от числа участников"
                        whatsappMessage={whatsappMessage}
                />

                <PhotoGallerySecondary photos={secondGalleryPhotos} />

                <TourAccordion />
                <TourCTA />
                <TourReviews category="colourful" categoryDisplayName="Колорит" />

            </article>

            <FloatingBookingBtn />
            <PhotoFullscreenOverlay />
        </div>
    </section>

    <script is:inline src="/assets/js/pages/booking.js"></script>
    <script is:inline src="/assets/js/pages/galleria.js"></script>
    <script is:inline src="/assets/js/pages/accordion.js"></script>
</BaseLayout>