---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TourHero from '../../../components/tour/TourHero.astro';
import BookingWidget from '../../../components/tour/BookingWidget.astro';
import PhotoGallerySecondary from '../../../components/tour/PhotoGallerySecondary.astro';
import TourAccordion from '../../../components/tour/TourAccordion.astro';
import TourCTA from '../../../components/tour/TourCTA.astro';
import TourReviews from '../../../components/tour/TourReviews.astro';
import FloatingBookingBtn from '../../../components/tour/FloatingBookingBtn.astro';
import PhotoFullscreenOverlay from '../../../components/tour/PhotoFullscreenOverlay.astro';

const secondGalleryPhotos = Array.from({ length: 14 }, (_, i) => ({
    image: `/assets/img/stambul/${i + 1}.webp`,
    title: `Фото ${i + 1}`,
}));

const whatsappMessage = 'Здравствуйте!%20Хочу%20забронировать%20экскурсию%20%22Стамбул%20—%20мост%20между%20Европой%20и%20Азией%22.%0A%0A📅%20Дата:%20[введите%20дату]%0A👥%20Количество%20человек:%20[1–5]%0A👶%20Будут%20ли%20дети:%20[да/нет]%0A⏱%20Продолжительность:%205–6%20часов%0A💬%20Комментарий:%20[ваш%20вопрос]%0A%0AСпасибо!';
---
<BaseLayout title="Стамбул — мост между Европой и Азией" description="Хотите узнать истинное величие Стамбула? Увидьте этот город с двух континентов.">
    <Fragment slot="head">
        <link rel="stylesheet" href="/assets/css/pages/booking.css">
        <link rel="stylesheet" href="/assets/css/layout/tourMapSelected.css">
        <link rel="stylesheet" href="/assets/css/layout/route.css">
        <link rel="stylesheet" href="/assets/css/layout/galleria.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
        <link rel="stylesheet" href="/assets/css/layout/accordion.css">
        <link rel="stylesheet" href="/assets/css/pages/reviews.css">
        <link rel="stylesheet" href="/assets/css/layout/fix.css">
        <link rel="stylesheet" href="/assets/css/layout/reservation.css">
    </Fragment>

    <section>
        <div class="container">
            <article>

                <TourHero
                        image="/assets/img/stambul/2.webp"
                        title="Стамбул - мост между Европой и Азией"
                        subtitle="Хотите узнать истинное величие Стамбула? Тогда приглашаю вас увидеть этот город с двух континентов!"
                />

                <div class="excursion-text">
                    <p>Ох уж этот Стамбул! Манящий, загадочный, пленительный и такой разный - не зря о нем говорят «город контрастов». Увидим, как выглядит и чем живет мегаполис на двух континентах - Европе и Азии.</p>

                    <h2 class="section-title">Что вас ожидает</h2>

                    <div class="subsection-title">Босфорский мост</div>
                    <p class="subsection-text">Босфорский мост — первый мост через Босфорский пролив. Висячий мост соединяет европейскую и азиатскую части Стамбула около мечети Ортакёй. Из всех трёх мостов через Босфор он расположен ближе всего к центру города</p>

                    <div class="subsection-title">Дворец Бейлербей</div>
                    <p class="subsection-text">Бейлербейский дворец был построен по заказу султана Абдул-Азиза (1830–1876) в качестве летней резиденции глав государств. Императрица Эжени (Евгения) из Франции (супруга Наполеона III) посетила Бейлербей на пути к открытию Суэцкого канала в 1869 году. Расскажу вам чем закончился ее визит в это место!</p>

                    <div class="subsection-title">Район Кузгунджук</div>
                    <p class="subsection-text">Район Кузгунджук — колоритный и красочный район Стамбула, расположенный в азиатской части. Начинается он с набережной Босфора, прямо от первого моста через пролив. Когда-то Кузгунджук был заселен евреями и от них в наследство району остались колоритные двухэтажные деревянные домики, окрашенные в яркие цвета.</p>

                    <div class="subsection-title">Холм Чамлыджа</div>
                    <p class="subsection-text">Холм Чамлыджа — уютная парковая зона с множеством природных фотозон, вид сверху умопомрачительный: Босфор как на ладони, мечети, крепости, мосты, башни — всё перед вами!</p>

                    <div class="subsection-title">Мечеть Чамлыджа</div>
                    <p class="subsection-text">Мечеть Чамлыджа (открылась в 2019 г.), мечеть с шестью минаретами является одной из самых больших в Турции и мире, располагается в самой высокой точке города.</p>

                    <div class="subsection-title">Девичья Башня</div>
                    <p class="subsection-text">Девичья Башня является одним из символов города. С этим местом связаны мифология, войны, история и конечно легенда, но её вы узнаете на экскурсии!</p>

                    <div class="info-sections">
                        <div class="info-block">
                            <h3 class="info-title">Организационные детали</h3>
                            <ul>
                                <li>Экскурсия проходит в комбинированном формате (авто + пешком)</li>
                                <li>Между локациями мы будем передвигаться на комфортабельном минивэне.</li>
                                <li>Дополнительные расходы: входные билеты в Дворец Берлейбей — 900 лир/чел.</li>
                                <li>По понедельникам дворец Берлейбей закрыт.</li>
                                <li>Мы будем посещать мечеть, поэтому, пожалуйста, позаботьтесь о соответствующей одежде (как женщины, так и мужчины).</li>
                            </ul>
                        </div>
                    </div>

                    <div class="meeting-point">
                        <h3 class="info-title">Место встречи</h3>
                        <p>По договоренности с организатором.<br>
                            Вы можете обсудить его в заказе до предоплаты.</p>
                    </div>
                </div>

                <div class="booking-conditions">
                    <h1 class="title">Условия бронирования</h1>
                    <div class="conditions-grid">
                        <div class="condition-card">
                            <span class="condition-icon">👥</span>
                            <h3 class="condition-title">Индивидуальный формат</h3>
                            <p class="condition-description">Только для вас и вашей компании, <span class="highlight">1-5 человек</span></p>
                        </div>
                        <div class="condition-card">
                            <span class="condition-icon">💰</span>
                            <h3 class="condition-title">Предоплата 20%</h3>
                            <p class="condition-description"><span class="highlight">остальное —</span><br>организатору напрямую</p>
                        </div>
                        <div class="condition-card">
                            <span class="condition-icon">🗣️</span>
                            <h3 class="condition-title">Проходит на русском языке</h3>
                            <p class="condition-description">Экскурсия проводится на русском языке для лучшего понимания</p>
                        </div>
                        <div class="condition-card">
                            <span class="condition-icon">❓</span>
                            <h3 class="condition-title">Задать вопросы организатору</h3>
                            <p class="condition-description">можно <span class="highlight">в заказе до предоплаты</span></p>
                        </div>
                    </div>
                </div>

                <BookingWidget
                        duration="5-6 часа наслаждения"
                        format="1-5 человек - Семейный"
                        method="Комбинированный маршрут: авто и пешком"
                        price="€300"
                        priceNote="за 1–5 человек, независимо от числа участников"
                        whatsappMessage={whatsappMessage}
                />

                <PhotoGallerySecondary photos={secondGalleryPhotos} />

                <TourAccordion />
                <TourCTA />
                <TourReviews category="stambul" categoryDisplayName="Стамбул мост" />

            </article>

            <FloatingBookingBtn />
            <PhotoFullscreenOverlay />
        </div>
    </section>

    <script is:inline src="/assets/js/pages/booking.js"></script>
    <script is:inline src="/assets/js/pages/galleria.js"></script>
    <script is:inline src="/assets/js/pages/accordion.js"></script>
</BaseLayout>