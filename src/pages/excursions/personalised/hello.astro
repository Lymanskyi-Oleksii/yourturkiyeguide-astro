---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TourHero from '../../../components/tour/TourHero.astro';
import TourGalleryCarousel from '../../../components/tour/TourGalleryCarousel.astro';
import BookingWidget from '../../../components/tour/BookingWidget.astro';
import PhotoGallerySecondary from '../../../components/tour/PhotoGallerySecondary.astro';
import TourAccordion from '../../../components/tour/TourAccordion.astro';
import TourCTA from '../../../components/tour/TourCTA.astro';
import TourReviews from '../../../components/tour/TourReviews.astro';
import FloatingBookingBtn from '../../../components/tour/FloatingBookingBtn.astro';
import PhotoFullscreenOverlay from '../../../components/tour/PhotoFullscreenOverlay.astro';

const routeItems = [
    { image: '/assets/img/hello/1.webp', alt: 'Айя-София', title: 'Айя-София', description: 'Мечеть, сочетающая в себе элементы православной и мусульманской культуры, а также включенная в список Всемирного наследия Юнеско.' },
    { image: '/assets/img/hello/7.webp', alt: 'Дворец Топкапы', title: 'Дворец Топкапы', description: 'Главный дворец Османской империи, в котором жили и правили 25 султанов.' },
    { image: '/assets/img/hello/3.webp', alt: 'Римский ипподром', title: 'Римский ипподром', description: 'Площадь Султанахмед — это главная площадь Стамбула c сохранившимися памятниками разных цивилизаций.' },
    { image: '/assets/img/hello/2.webp', alt: 'Голубая мечеть', title: 'Голубая мечеть', description: 'Выдающийся шедевр исламской и мировой архитектуры 17 века.' },
    { image: '/assets/img/hello/5.webp', alt: 'Цистерна Базилика', title: 'Цистерна Базилика', description: 'Одно из самых крупных и хорошо сохранившихся древних подземных водохранилищ Константинополя.' },
];

const secondGalleryPhotos = Array.from({ length: 10 }, (_, i) => ({
    image: `/assets/img/hello/${i + 1}.webp`,
    title: `Фото ${i + 1}`,
}));

const whatsappMessage = 'Здравствуйте!%20Хочу%20забронировать%20персональную%20экскурсию%20%22Привет,%20Стамбул!%22%20на%204%20часа%20для%20группы.%0A%0A📅%20Дата:%20[введите%20дату]%0A👥%20Количество%20человек:%20[до%206]%0A👶%20Будут%20ли%20дети:%20[да/нет]%0A💬%20Комментарий:%20[ваш%20вопрос]%0A%0AСпасибо!';
---
<BaseLayout title="Привет, Стамбул!" description="Главные достопримечательности Стамбула на легкой и душевной экскурсии с профессиональным гидом.">
    <Fragment slot="head">
        <link rel="stylesheet" href="/assets/css/pages/booking.css">
        <link rel="stylesheet" href="/assets/css/layout/tourMapSelected.css">
        <link rel="stylesheet" href="/assets/css/layout/route.css">
        <link rel="stylesheet" href="/assets/css/layout/galleria.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
        <link rel="stylesheet" href="/assets/css/layout/accordion.css">
        <link rel="stylesheet" href="/assets/css/pages/reviews.css">
        <link rel="stylesheet" href="/assets/css/layout/fix.css">
        <link rel="stylesheet" href="/assets/css/layout/reservation.css">
    </Fragment>

    <section>
        <div class="container">
            <article>

                <TourHero
                        image="https://images.unsplash.com/photo-1541432901042-2d8bd64b4a9b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2000&q=80"
                        title="Привет, Стамбул!"
                        subtitle="Главные достопримечательности города на легкой и душевной экскурсии с профессиональным гидом"
                />

                <div class="excursion-text">
                    <p>В Стамбуле переплелось всё: османская и византийская эпохи, христианство и ислам, древние святыни и современный дух. Вы услышите неоднозначную историю Айя-Софии, посетите волшебный дворец Топкапы, заглянете в таинственный Гарем и оцените водохранилище Цистерна Базилика. Познакомитесь с местными котиками и полюбуетесь Босфором.</p>

                    <h2 class="section-title">Что вас ожидает</h2>

                    <div class="subsection-title">Символы великого города</div>
                    <p class="subsection-text">Вы осмотрите визитные карточки Стамбула: Айя-Софию, Цистерну Базилику и Голубую мечеть. Я расскажу о султане Сулеймане Великом и его жене Роксолане, о «золотом веке» Византии и о временах, когда Стамбул был столицей Османской империи. Поделюсь «историей 6 минаретов» и раскрою, очевидцем каких важных событий был наш город. А также покажу лучшие фотолокации и помогу понять, как Стамбулу удается сочетать древний и современный дух.</p>

                    <div class="subsection-title">Дворец Топкапы и площадь Султанахмет</div>
                    <p class="subsection-text">На центральной площади Султанахмет вы увидите Египетский обелиск, Немецкий фонтан и Змеиную колонну. Раскроете, при каких обстоятельствах они здесь появились, и услышите интересные факты о Константинополе. Во дворце Топкапы погуляете по роскошным залам, галереям и живописному парку с видом на Босфор. Я расскажу о сериале «Великолепный век», взлетах и падении Османской империи, султанах и их наложницах.</p>

                    <TourGalleryCarousel items={routeItems} />

                    <div class="info-sections">
                        <div class="info-block">
                            <h3 class="info-title">Организационные детали</h3>
                            <ul>
                                <li>По запросу я могу провести экскурсию для группы более 7-и человек; стоимость и детали уточняйте в личном сообщении</li>
                                <li>Для посещения мечетей женщинам необходимо взять с собой платок, а длина одежды должна быть ниже колен</li>
                            </ul>
                        </div>

                        <div class="info-block">
                            <h3 class="info-title">Дополнительные расходы</h3>
                            <ul>
                                <li>Входные билеты во дворец Топкапы — 2400 лир с человека</li>
                                <li>При посещении гарема время увеличивается на 40 минут (+15€)</li>
                                <li>По вторникам дворец закрыт, посещаем мечеть Сулеймание</li>
                                <li>Цистерна Базилика — 1300 лир с человека</li>
                                <li>Айя-София — 25 евро с человека</li>
                                <li>Возможна замена дворца Топкапы на мечеть Сулеймана Великолепного</li>
                            </ul>
                        </div>
                    </div>

                    <div class="meeting-point">
                        <h3 class="info-title">Место встречи</h3>
                        <p>Начало экскурсии у мечети Айя-София.<br>
                            Точное место встречи вы узнаете после внесения предоплаты.</p>
                    </div>
                </div>

                <div class="booking-conditions">
                    <h1 class="title">Условия бронирования</h1>
                    <div class="conditions-grid">
                        <div class="condition-card">
                            <span class="condition-icon">👥</span>
                            <h3 class="condition-title">Индивидуальный формат</h3>
                            <p class="condition-description">Только для вас и вашей компании, <span class="highlight">1-6 человек</span></p>
                        </div>
                        <div class="condition-card">
                            <span class="condition-icon">💰</span>
                            <h3 class="condition-title">Предоплата 20%</h3>
                            <p class="condition-description"><span class="highlight">остальное —</span><br>организатору напрямую</p>
                        </div>
                        <div class="condition-card">
                            <span class="condition-icon">🗣️</span>
                            <h3 class="condition-title">Проходит на русском языке</h3>
                            <p class="condition-description">Экскурсия проводится на русском языке для лучшего понимания</p>
                        </div>
                        <div class="condition-card">
                            <span class="condition-icon">❓</span>
                            <h3 class="condition-title">Задать вопросы организатору</h3>
                            <p class="condition-description">можно <span class="highlight">в заказе до предоплаты</span></p>
                        </div>
                    </div>
                </div>

                <BookingWidget
                        duration="4 часа наслаждения"
                        format="1-6 человек - Семейный"
                        method="Пешком с интересными остановками"
                        price="€180"
                        priceNote="за 1–6 человек, независимо от числа участников"
                        whatsappMessage={whatsappMessage}
                />

                <PhotoGallerySecondary photos={secondGalleryPhotos} />

                <TourAccordion />
                <TourCTA />
                <TourReviews category="istanbul" categoryDisplayName="Стамбул" />

            </article>

            <FloatingBookingBtn />
            <PhotoFullscreenOverlay />
        </div>
    </section>

    <script is:inline src="/assets/js/pages/booking.js"></script>
    <script is:inline src="/assets/js/pages/picture.js"></script>
    <script is:inline src="/assets/js/pages/galleria.js"></script>
    <script is:inline src="/assets/js/pages/accordion.js"></script>
</BaseLayout>