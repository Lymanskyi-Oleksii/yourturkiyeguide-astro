---
import BaseLayout from '../../layouts/BaseLayout.astro';
// Стилі підключаються імпортом: Astro їх мініфікує й дає назви з хешем (пункт 6.4)
import '../../styles/tour-list.css';
import TourCard from '../../components/TourCard.astro';
import TourFilter from '../../components/TourFilter.astro';
import { getTours, tourHref } from "../../data/tours";
const tours = await getTours("copyright");
import TourCTA from "../../components/tour/TourCTA.astro";

// Підписи типів; список варіантів будується з даних
const LABELS: Record<string, string> = {
    'историческая': 'Исторические',
    'искусство': 'Художественные',
    'морская прогулка': 'Морские прогулки',
    'многодневный': 'Многодневные туры',
};
// Пошук і фільтри мають сенс лише коли турів достатньо
const showFilters = tours.length > 3;
---
<BaseLayout title="Авторские туры" description="Авторские туры по Турции — индивидуальная программа и нестандартные маршруты.">
    <section>
        <div class="container">
            <article>

                <div class="tours-section">
                    <h1>Авторские туры по Стамбулу</h1>
                    <p>Вы хотите отправиться в незабываемое путешествие, но стандартные предложения туроператоров вам изрядно поднадоели?</p>
                    <p>Тогда мои авторские предложения именно для вас! Полная организация вашего отдыха, нестандартная программа и индивидуальный подход с меня, а все, что остается вам — только приехать и наслаждаться прекрасным отдыхом!</p>
                </div>

                {showFilters && (
                <TourFilter
                        tours={tours}
                        categoryLabels={LABELS}
                        searchPlaceholder="Поиск туров..."
                        categoryLabel="Тип тура"
                        allCategoriesLabel="Все туры"
                        multiDay
                />
                )}

                <div class="card-container" id="cardContainer">
                    {tours.map((tour) => <TourCard href={tourHref(tour)} {...tour} />)}
                </div>

                {showFilters && (
                <div class="no-results" id="noResults" style="display: none;">
                    <h3>Экскурсии не найдены</h3>
                    <p>Попробуйте изменить параметры поиска</p>
                </div>
                )}

                <TourCTA
                        title="Не нашли нужную экскурсию?"
                        subtitle="Напишите мне - подберу маршрут именно для вас!"
                />

            </article>
        </div>
    </section>

</BaseLayout>