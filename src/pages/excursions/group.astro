---
import BaseLayout from '../../layouts/BaseLayout.astro';
// Стилі підключаються імпортом: Astro їх мініфікує й дає назви з хешем (пункт 6.4).
// Та сама збірка, що й у personalised/copyright, щоб заголовок і вступ виглядали однаково
import '../../styles/tour-list.css';
import TourCTA from '../../components/tour/TourCTA.astro';
---
<BaseLayout title="Групповые экскурсии" description="Групповые экскурсии по Стамбулу и Турции в небольших группах: дружеская атмосфера, профессиональный гид и доступная цена.">
    <section>
        <div class="container">
            <article class="container-article">
                <div class="tours-section">
                    <h1>Групповые экскурсии</h1>
                    <p>Групповая экскурсия — хороший выбор, если вы путешествуете с друзьями или семьёй, хотите сэкономить и не против компании других туристов. Мы идём небольшой группой, поэтому атмосфера остаётся дружеской, а у каждого есть возможность задать вопрос гиду.</p>
                    <p>За основу можно взять любой маршрут из <a href="/excursions/personalised">индивидуальных экскурсий</a> или <a href="/excursions/copyright">авторских туров</a>. Расскажите, сколько вас и какие даты вам подходят, — подскажу, когда собирается ближайшая группа, или организую экскурсию для вашей компании.</p>
                </div>

                <TourCTA
                        title="Хотите присоединиться к группе?"
                        subtitle="Напишите мне даты и количество человек — подберу подходящую экскурсию."
                />
            </article>
        </div>
    </section>
</BaseLayout>
