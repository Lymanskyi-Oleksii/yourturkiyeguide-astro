---
import BaseLayout from '../../layouts/BaseLayout.astro';
// Стилі підключаються імпортом: Astro їх мініфікує й дає назви з хешем (пункт 6.4)
import '../../styles/tour-list.css';
import TourCard from '../../components/TourCard.astro';
import TourFilter from '../../components/TourFilter.astro';
import { getTours, tourHref } from "../../data/tours";
const tours = await getTours("personalised");
import TourCTA from '../../components/tour/TourCTA.astro'

// Підписи тем; список варіантів будується з даних, тому порожніх не буде
const LABELS: Record<string, string> = {
    'историческая': 'Историческая',
    'искусство': 'Искусство',
    'морская прогулка': 'Морская прогулка',
    'многодневный': 'Многодневный тур',
};
---
<BaseLayout title="Индивидуальные экскурсии" description="Индивидуальные экскурсии по Стамбулу под ваши интересы.">
    <section>
        <div class="container">
            <article>

                <div class="tours-section">
                    <h1>Индивидуальные экскурсии по Стамбулу</h1>
                    <p>Откройте Стамбул так, как вы хотите: наедине с гидом, в компании друзей или семьи.</p>
                    <p>Разработаем маршрут под ваши интересы!</p>
                </div>

                <TourFilter
                        tours={tours}
                        categoryLabels={LABELS}
                        searchPlaceholder="Поиск экскурсий..."
                        categoryLabel="Тематика экскурсии"
                        allCategoriesLabel="Все темы"
                />

                <div class="card-container" id="cardContainer">
                    {tours.map((tour) => <TourCard href={tourHref(tour)} {...tour} />)}
                </div>

                <div class="no-results" id="noResults" style="display: none;">
                    <h3>Экскурсии не найдены</h3>
                    <p>Попробуйте изменить параметры поиска</p>
                </div>

                <TourCTA
                        title="Не нашли нужную экскурсию?"
                        subtitle="Напишите мне — подберу маршрут именно для вас!"
                />

            </article>
        </div>
    </section>

</BaseLayout>