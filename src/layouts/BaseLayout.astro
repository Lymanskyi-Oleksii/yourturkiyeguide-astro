---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
    title = "Гид по Турции",
    description = "Индивидуальные и групповые экскурсии по Турции с профессиональным гидом. Яхты, трансфер, медицинский туризм.",
} = Astro.props;
---
<!doctype html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>

    <!-- Open Graph — як виглядатиме посилання при шарингу в Telegram/WhatsApp/Facebook -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="/assets/img/ferat/home.webp">
    <meta property="og:type" content="website">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="icon" href="/icon.webp" type="image/webp">
    <link rel="stylesheet" href="/assets/css/pages/main_style.css">
    <link rel="stylesheet" href="/assets/css/layout/style.css">
    <slot name="head" />
</head>
<body>
<Header />
<slot />
<Footer />
<script is:inline src="/assets/js/script.js"></script>
</body>
</html>